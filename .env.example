# Copy to .env and fill in from your Supabase project (Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: region of the database, e.g. us-west-2. The api function then runs next to it, which is much faster.
EXPO_PUBLIC_SUPABASE_FUNCTION_REGION=
